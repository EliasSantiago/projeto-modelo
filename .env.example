# ==========================================================================
# Projeto Modelo, variáveis de ambiente
# Copie para `.env.local` e preencha. NUNCA commite `.env.local`.
# Apenas variáveis com prefixo NEXT_PUBLIC_ são expostas ao browser.
# ==========================================================================

# --- Banco de dados (Neon Postgres), SÓ SERVIDOR ------------------------
# Connection string do Neon (use a "pooled" para runtime serverless).
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"

# --- Auth.js (NextAuth v5), SÓ SERVIDOR ---------------------------------
# Gere com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-forte"
# URL canônica da app (obrigatória em produção; opcional em dev).
AUTH_URL="http://localhost:3000"

# OAuth Google, https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OAuth GitHub, https://github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- E-mail, SÓ SERVIDOR -------------------------------------------------
# Usado na recuperação de senha e na confirmação de e-mail.
#
# Em dev, se nada estiver configurado, o e-mail é impresso no console do
# servidor (é assim que se pega o link localmente).
# OBRIGATÓRIO EM PRODUÇÃO: sem provedor real, o envio lança erro em vez de
# descartar a mensagem em silêncio.

# Remetente. Formato "Nome <endereco@dominio.com>" também é aceito.
MAIL_FROM="Projeto Modelo <no-reply@example.com>"

# Provedor explícito: resend | smtp | console.
# Se vazio, detecta automaticamente na ordem: resend → smtp → console.
MAIL_PROVIDER=""

# Opção A, Resend (recomendado em serverless: API HTTP, sem porta SMTP).
# Crie a chave em https://resend.com/api-keys e verifique seu domínio.
RESEND_API_KEY=""

# Opção B, SMTP (qualquer provedor com credencial SMTP, ou relay próprio).
AUTH_EMAIL_SERVER=""
# Nome legado de MAIL_FROM, ainda aceito para não quebrar .env antigos.
AUTH_EMAIL_FROM=""

# --- Rate limiting (Upstash Redis), SÓ SERVIDOR --------------------------
# Protege login, cadastro e recuperação de senha contra força bruta e
# bombardeio de e-mail. Crie um banco Redis em https://upstash.com
# (ou via Vercel Marketplace) e cole as credenciais REST.
#
# Sem estas variáveis o limitador cai para um contador EM MEMÓRIA: resolve em
# dev, mas em serverless não é compartilhado entre instâncias, então o limite
# efetivo vira `cota × nº de instâncias`. Configure em produção.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Público (exposto ao cliente) ----------------------------------------
NEXT_PUBLIC_APP_NAME="Projeto Modelo"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
